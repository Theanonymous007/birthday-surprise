{
  "name": "a-little-universe",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "birthday-surprises"
    }
  ]
}
